# Flask 配置
FLASK_HOST=0.0.0.0
FLASK_PORT=8765
FLASK_DEBUG=False

# CORS 配置（多个来源用逗号分隔）
# 开发环境示例：
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 生产环境示例：
# CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=*

# 数据库配置
DATABASE_URL=sqlite:///./landuse.db

# 数据文件路径（可选，使用默认值则无需配置）
# LANDUSE_DATA_PATH=data/processed_landuse.csv
# RASTER_DATA_DIR=../裁剪文件/
# VECTOR_BOUNDARIES_PATH=data/vector/county_boundaries.shp

# 日志级别（可选）
# LOG_LEVEL=INFO
